619. Biggest Single Number

# Write your MySQL query statement below

SELECT 
CASE 
    WHEN COUNT(num) = 1 THEN num 
    ELSE NULL 
    END AS num
FROM MyNumbers
GROUP BY num
ORDER BY num DESC
LIMIT 1;

Solution 2:
SELECT MAX(num) AS num
FROM (
    SELECT num
    FROM MyNumbers
    GROUP BY num
    HAVING COUNT(num) = 1
) AS unique_numbers;
