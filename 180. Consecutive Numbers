180. Consecutive Numbers

select distinct a.num as ConsecutiveNums
from logs a
inner join logs b
on a.id + 1 = b.id and a.num = b.num
inner join logs c
on a.id + 2 = c.id and a.num = c.num;

Solution 2:

SELECT DISTINCT l1.num AS ConsecutiveNums
FROM Logs l1, Logs l2, Logs l3
WHERE l1.num = l2.num
  AND l2.num = l3.num
  AND l1.id = l2.id - 1
  AND l2.id = l3.id - 1;
