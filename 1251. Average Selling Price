1251. Average Selling Price

# Write your MySQL query statement below
SELECT p.product_id, 
COALESCE(ROUND(SUM(p.price * u.units) / SUM(u.units), 2), 0) AS average_price
FROM Prices p
LEFT JOIN UnitsSold u 
ON p.product_id = u.product_id AND purchase_date BETWEEN start_date AND end_date
GROUP BY p.product_id

--  Solution 2

select p.product_id,
round(sum(case when u.purchase_date between p.start_date and p.end_date then
p.price*u.units
else
0
end)/sum(distinct u.units)
,2) as average_price
from Prices p
left outer join UnitsSold u
on p.product_id=u.product_id
group by p.product_id

--  Solution 3

select p.product_id, ifnull(round(sum((p.price * u.units))/sum(u.units), 2), 0.00 ) as average_price
 from prices p
left join unitssold u
on p.product_id = u.product_id and u.purchase_date <= p.end_date and u.purchase_date >= p.start_date
group by product_id
