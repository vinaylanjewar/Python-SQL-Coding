1934. Confirmation Rate

--  Solution 1

# Write your MySQL query statement below
select distinct Signups.user_id,
round(ifnull(count(case when action = 'confirmed' then action else null end)over(partition by user_id) / count(action)over(partition by user_id),0),2) as confirmation_rate
from Confirmations 
right join Signups 
on Confirmations.user_id = Signups.user_id

--  Solution 2

SELECT a.user_id, round(ifnull(avg(action = 'confirmed'), 0),2) as confirmation_rate
FROM Signups a
LEFT JOIN Confirmations b
ON a.user_id = b.user_id
GROUP BY a.user_id

-- SOlution 3

# Write your MySQL query statement below
SELECT s.user_id, 
    Round(
        AVG(
            CASE 
                WHEN action = 'confirmed' THEN 1.00
                ELSE 0
            END
        )
    ,2) AS confirmation_rate 
FROM Signups s 
LEFT JOIN Confirmations c
    ON s.user_id = c.user_id 
GROUP BY s.user_id
   
