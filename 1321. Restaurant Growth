SELECT visited_on, amount, average_amount 
FROM 
(SELECT DISTINCT visited_on, SUM(amount) OVER
 (ORDER BY visited_on RANGE BETWEEN INTERVAL 6 DAY PRECEDING AND CURRENT ROW) AS amount,
  ROUND(SUM(amount) OVER (ORDER BY visited_on RANGE BETWEEN INTERVAL 6 DAY PRECEDING AND CURRENT ROW)/7,2)
   AS average_amount
FROM Customer) as whole_totals
WHERE DATEDIFF(visited_on, (SELECT MIN(visited_on) FROM Customer)) >= 6

Solution 3:

# Write your MySQL query statement below
SELECT 
    c1.visited_on,
    SUM(c2.amount) AS amount,
    ROUND(SUM(c2.amount) / 7, 2) AS average_amount
FROM 
    (SELECT visited_on, SUM(amount) AS amount
     FROM Customer
     GROUP BY visited_on) c1
JOIN 
    (SELECT visited_on, SUM(amount) AS amount
     FROM Customer
     GROUP BY visited_on) c2
ON 
    c2.visited_on BETWEEN DATE_SUB(c1.visited_on, INTERVAL 6 DAY) AND c1.visited_on
GROUP BY 
    c1.visited_on
HAVING 
    COUNT(*) = 7
ORDER BY 
    c1.visited_on;
