1071. Greatest Common Divisor of Strings

class Solution(object):
    def gcdOfStrings(self, str1, str2):
        if str1 + str2 != str2 + str1:
            return ""

        def gcd(n1, n2):
            r = n1 % n2
            if r == 0:
                return n2
            else:
                return gcd(n2, r)
        
        idx = gcd(len(str1), len(str2))
        return str1[:idx]

