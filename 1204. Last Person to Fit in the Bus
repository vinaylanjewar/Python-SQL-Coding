1204. Last Person to Fit in the Bus

with cte as (
select person_name, 
sum(weight) over(order by turn) as bus_weight from Queue
)
select person_name 
from cte 
where bus_weight<=1000 
order by bus_weight desc 
limit 1

solution 2:
SELECT person_name
from (SELECT person_name,turn,sum(weight) 
      over (order by turn) AS cum 
      FROM queue) p1
where cum<=1000 
order by turn DESC limit 1;
